{
  "name": "plainco-app",
  "main": "index.js",
  "version": "1.0.0",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:rules": "node scripts/run-rules-tests.mjs",
    "preview:email": "node scripts/preview-email.mjs",
    "test:rate-limit": "node scripts/test-rate-limit.mjs",
    "test:order-number": "node --no-warnings=MODULE_TYPELESS_PACKAGE_JSON scripts/test-order-number.mjs",
    "test:email": "node scripts/run-rules-tests.mjs scripts/test-email.mjs",
    "test:checkout": "node scripts/run-rules-tests.mjs scripts/test-checkout.mjs",
    "rules:deploy": "firebase deploy --only firestore:rules",
    "indexes:deploy": "firebase deploy --only firestore:indexes",
    "storage:deploy": "firebase deploy --only storage",
    "emulators": "firebase emulators:start --only auth,firestore,functions,storage",
    "start:emulator": "node scripts/start-with-emulators.mjs",
    "seed:emulator": "node scripts/seed-emulator.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "^57.0.16",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "11.4.1",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/native-stack": "^7.10.1",
    "expo": "~54.0.37",
    "expo-clipboard": "~8.0.8",
    "expo-constants": "~18.0.14",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.12",
    "expo-location": "~19.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "firebase": "^12.8.0",
    "react": "^19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "~19.1.0",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "firebase-tools": "^15.27.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
