rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Role split: "admin" was replaced by two non-overlapping roles.
    // isSeller() -> product/order/support-request duties.
    // isPlatformAdmin() -> user-account/role management duties.
    // Neither is a superset of the other.
    function isSeller() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'seller' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true) != false;
    }
    function isPlatformAdmin() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'platformAdmin' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true) != false;
    }
    // Multi-store: a Store Manager runs ONE store, named by storeId on
    // their own user document. isSeller() still answers "is this account
    // staff at all"; this answers "is it staff for THAT store".
    //
    // The `is string` check is load-bearing, not tidiness. A seller
    // promoted before stores existed has no storeId, and a product created
    // before stores existed has none either — both read as null through
    // .get(). Without the type check, null == null would hand every
    // unassigned manager every unassigned product. An account with no
    // store manages nothing until a Platform Admin assigns one.
    //
    // Same document isSeller() already reads, so this costs no extra
    // access against the ten-per-request ceiling.
    function managesStore(storeId) {
      return isSeller() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('storeId', null) is string &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('storeId', null) == storeId;
    }
    // Keeps role and storeId consistent whenever a Platform Admin touches
    // either: a Store Manager must point at a store that exists, and
    // anyone else must carry no storeId at all. A stale storeId left on a
    // demoted account would be harmless today (managesStore also needs
    // isSeller()), but it would silently hand that store back the moment
    // someone re-promoted the account, without anyone choosing to.
    //
    // existsAfter rather than exists: AdminUsersScreen opens a new store
    // and assigns its manager in one batch, and plain exists() reads the
    // database as it was BEFORE that batch, so the new store would not be
    // there yet. The store write in the batch is still judged by its own
    // /stores rule, so this admits nothing a Platform Admin couldn't do in
    // two separate writes.
    //
    // Checked only when role or storeId is actually changing, so that
    // deactivating a manager promoted before stores existed still works.
    // Revoking access must never be blocked by an unrelated field.
    function storeAssignmentIsValid() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'storeId']) ||
        (
          request.resource.data.get('role', '') == 'seller' &&
          request.resource.data.get('storeId', null) is string &&
          existsAfter(/databases/$(database)/documents/stores/$(request.resource.data.storeId))
        ) ||
        (
          request.resource.data.get('role', '') != 'seller' &&
          !('storeId' in request.resource.data)
        );
    }
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }
    // The order a chat message belongs to, for its storeId.
    function chatOrder(userId, orderId) {
      return get(/databases/$(database)/documents/users/$(userId)/orders/$(orderId));
    }
    // Order chat keeps three kinds of bookkeeping on the order itself, so
    // the order lists both sides already load can show an unread dot
    // without a query per row: when the last message was sent and by
    // which side, and when each side last read the conversation.
    //
    // A side may touch only lastMessageAt/lastMessageBy and its OWN read
    // marker, and every timestamp must be the server's clock — so the
    // customer cannot mark the store's messages read, and neither side can
    // backdate or future-date anything to hide or fake an unread message.
    function chatMetaIsValid(side, readField) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.size() > 0 &&
        changed.hasOnly(['lastMessageAt', 'lastMessageBy', readField]) &&
        (
          !changed.hasAny(['lastMessageAt', 'lastMessageBy']) ||
          (request.resource.data.lastMessageAt == request.time &&
           request.resource.data.lastMessageBy == side)
        ) &&
        (!(readField in changed) || request.resource.data[readField] == request.time);
    }
    function isActiveOwner(userId) {
      return isOwner(userId) &&
        (!exists(/databases/$(database)/documents/users/$(userId)) ||
         get(/databases/$(database)/documents/users/$(userId)).data.get('isActive', true) != false);
    }
    // Same "not deactivated" check as isActiveOwner, but for writes that
    // aren't scoped to a specific userId path — reviews, which live in a
    // top-level collection keyed by orderId_productId rather than under
    // the author's user document.
    function isActiveUser() {
      return request.auth != null &&
        (!exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('isActive', true) != false);
    }
    match /users/{userId} {
      allow read: if isOwner(userId) || isPlatformAdmin();
      // Signup is CUSTOMER-ONLY provisioning, and this rule is what makes
      // that true rather than merely conventional. The update rule below
      // goes to real lengths to make role escalation impossible — but an
      // unvalidated create bypasses all of it, because a client that sets
      // role at creation time never performs an update at all. So create
      // is constrained to exactly the shape Signupscreen.js writes, as an
      // allowlist of keys (hasOnly) for the same reason the update shapes
      // use one: a denylist silently admits any field invented later.
      //
      // "role" and "isActive" are absent from that allowlist, so neither
      // can be set at creation by anyone, at any value. A new account is
      // therefore always an ordinary customer (both fields are read with
      // .get() defaults everywhere — see AdminContext's
      // resolvePrivilegedRole and AdminUsersScreen's snapshot mapping),
      // and the ONLY path to a privileged role is a platformAdmin's
      // update through the branch below. That is deliberate: staff
      // accounts are granted, never self-registered.
      //
      // uid must match the authenticated caller so the document can't
      // claim to belong to someone else. The three consent/timestamp
      // fields are optional in shape but written together by signup.
      allow create: if isOwner(userId) &&
        request.resource.data.keys().hasOnly(
          ['uid', 'name', 'email', 'createdAt', 'privacyConsentAccepted', 'privacyConsentTimestamp']
        ) &&
        request.resource.data.keys().hasAll(['uid', 'name', 'email']) &&
        request.resource.data.uid == request.auth.uid &&
        request.resource.data.name is string &&
        request.resource.data.name.matches('.*\\S.*') &&
        request.resource.data.name.size() <= 60 &&
        request.resource.data.email is string &&
        request.resource.data.email.matches('.*\\S.*');
      // An owner may only touch their own document through one of three
      // allowlisted shapes, expressed as the exact set of changed keys
      // (affectedKeys().hasOnly(...)) rather than a per-field denylist —
      // a denylist silently permits any field added later, an allowlist
      // does not. Because no shape below includes "role", any write
      // that changes role (e.g. a client-side self-promotion attempt)
      // necessarily fails every hasOnly() check and is denied outright,
      // regardless of what value is requested. Only a platformAdmin can
      // change role, isActive back to true, email, consent fields, or
      // timestamps.
      //
      // No delete rule exists for user documents, deliberately: SRS §2.4
      // requires accounts to be deactivated (isActive: false), not
      // deleted, so completed sales tied to that account stay auditable.
      // This applies to every role, including platformAdmin.
      //
      // Shape 1 — display name edit: "name" must be the only changed key,
      // a non-empty (non-whitespace-only, via regex — Rules has no trim())
      // string of at most 60 characters.
      //
      // Shape 2 — self-deactivation: "isActive" and "deactivatedAt" must
      // be the only changed keys, written together in one call (see
      // ProfileScreen.js), and the new isActive value must be false —
      // self-reactivation (isActive: true) is not a valid value here, so
      // it's rejected the same way any other unlisted change would be.
      //
      // Shape 3 — delivery address: LocationScreen.js writes the whole
      // address as one nested map, so "shippingAddress" is the only
      // affected key at the document level and the inner keys have to be
      // constrained separately — exactly the six form fields plus the
      // updatedAt timestamp, with all six present as non-empty strings.
      // SRS 2.5 Dependency 5 specifies one saved address per customer,
      // which this shape enforces (a single map, not a collection).
      //
      // Fields are read via .get() with a default: customer documents
      // created at signup do NOT have a role field at all, and dot notation
      // on a missing field throws an error that Firestore surfaces as
      // "Missing or insufficient permissions" — indistinguishable from a
      // real deny.
      //
      // platformAdmin branch: a platformAdmin may update role, isActive
      // and storeId (see storeAssignmentIsValid) on any user document
      // EXCEPT their own — this branch
      // cannot target the requester's own document at all. Without that
      // exclusion, a platformAdmin could demote or deactivate themselves
      // here and permanently lock the account role out of existence (no
      // one left who can grant platformAdmin). Self-deactivation is still
      // available to a platformAdmin the same way it is to any user: via
      // the ordinary owner-branch shape below. isSeller() gets no write
      // access here at all.
      allow update: if
        (
          isPlatformAdmin() &&
          !isOwner(userId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['role', 'isActive', 'storeId']) &&
          storeAssignmentIsValid()
        )
        ||
        (
          isOwner(userId) &&
          (
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) &&
              request.resource.data.get('name', '') is string &&
              request.resource.data.name.matches('.*\\S.*') &&
              request.resource.data.name.size() <= 60
            )
            ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['isActive', 'deactivatedAt']) &&
              request.resource.data.get('isActive', true) == false
            )
            ||
            // Profile photo: set, replaced, or removed (absent afterwards).
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['photoUrl']) &&
              (
                !('photoUrl' in request.resource.data) ||
                (request.resource.data.photoUrl is string &&
                 request.resource.data.photoUrl.size() > 0 &&
                 request.resource.data.photoUrl.size() <= 2000)
              )
            )
            ||
            (
              request.resource.data.diff(resource.data).affectedKeys().hasOnly(['shippingAddress']) &&
              request.resource.data.shippingAddress is map &&
              request.resource.data.shippingAddress.keys().hasOnly(
                ['fullName', 'phone', 'address', 'city', 'province', 'zipCode', 'updatedAt']
              ) &&
              request.resource.data.shippingAddress.keys().hasAll(
                ['fullName', 'phone', 'address', 'city', 'province', 'zipCode']
              ) &&
              request.resource.data.shippingAddress.fullName is string &&
              request.resource.data.shippingAddress.fullName.matches('.*\\S.*') &&
              request.resource.data.shippingAddress.phone is string &&
              request.resource.data.shippingAddress.phone.matches('.*\\S.*') &&
              request.resource.data.shippingAddress.address is string &&
              request.resource.data.shippingAddress.address.matches('.*\\S.*') &&
              request.resource.data.shippingAddress.city is string &&
              request.resource.data.shippingAddress.city.matches('.*\\S.*') &&
              request.resource.data.shippingAddress.province is string &&
              request.resource.data.shippingAddress.province.matches('.*\\S.*') &&
              request.resource.data.shippingAddress.zipCode is string &&
              request.resource.data.shippingAddress.zipCode.matches('.*\\S.*')
            )
          )
        );
      match /orders/{orderId} {
        // Read-only for the owning customer: order cancellation and
        // customer-driven status changes are unsupported per the SRS, so
        // only isSeller() may write here. Delete is intentionally absent
        // for every role — order records are preserved for audit and
        // transaction history per SRS §2.4.
        //
        // A Store Manager reads only their OWN store's orders: another
        // store's order carries a customer's name, phone and address, and
        // one seller has no business seeing who buys from another. A list
        // query must therefore filter on storeId == the manager's store —
        // rules are not filters, so an unfiltered query is refused whole,
        // which is what AdminOrdersScreen's where('storeId') is for.
        allow read: if isOwner(userId) || managesStore(resource.data.get('storeId', null));
        // NO CREATE RULE, for anyone. Orders are written exclusively by
        // the placeOrder Cloud Function (functions/index.js), which runs
        // with Admin SDK credentials and so bypasses this file entirely.
        // A client that tries to create an order document directly is
        // denied here, which is the point.
        //
        // WHY THE SHAPE VALIDATION THAT USED TO LIVE HERE IS GONE RATHER
        // THAN KEPT AS DEFENCE IN DEPTH: it was never defence in depth. A
        // create rule can only check the shape of what the client sends;
        // it cannot check that the prices in it are the prices in the
        // product documents, that the total is the sum of the lines, or
        // that the stock decrement travelling alongside it matches the
        // quantities ordered. The old rule permitted a client to invent a
        // total of 1 peso for a 3000-peso order and had no way to notice.
        // Validating shape while the numbers stay attacker-controlled is
        // not a weaker version of correct — it is a different thing that
        // reads like correct, and keeping it would suggest the collection
        // is guarded when the money in it is not. Removing the rule states
        // plainly that the server, and only the server, may write here.
        //
        // WHAT THIS MEANS FOR THE VERIFIED-PURCHASE CHAIN in
        // /reviews/{reviewId}: link 1 used to be "create pins status to
        // 'pending'", enforced by the rule above. It is now "only the
        // server creates orders, and it always writes 'pending'" —
        // functions/index.js sets status as a literal and accepts no
        // status from the caller. The link is stronger than it was (a
        // client cannot write the document at all), but it is enforced in
        // the function rather than in this file, so the two must be
        // changed together. Link 2 is unchanged and still lives below:
        // only isSeller() may move an order to 'delivered'.
        //
        // "productIds" — the flat list of product ids appearing in items —
        // is likewise written by the function now. It stays denormalised
        // because rules cannot iterate a list of maps: there is no way to
        // ask whether any element of items[] has productId == X, and the
        // reviews rule needs exactly that question answered. `X in
        // productIds` is the only form Firestore can evaluate.
        // Working an order means moving it between statuses, and that is
        // the only change this rule permits — the same treatment
        // supportRequests gets. A Store Manager cannot rewrite the total,
        // the line items, or the address the customer submitted, which
        // also means the quantities that a cancellation restores stock
        // from cannot be edited upward first.
        //
        // The transition to 'cancelled' is restricted further, because
        // cancelling is the one status change with an inventory
        // consequence: AdminOrdersScreen restores each line's quantity to
        // its product's stock in the same transaction as this write. Only
        // an order that hasn't shipped may take that path — past that
        // point the goods are with the courier or the customer, and
        // restoring stock would invent inventory that doesn't exist.
        //
        // Note what the same clause does for a SECOND cancellation:
        // 'cancelled' is not itself in the allowed set, so re-cancelling
        // an already-cancelled order is denied here, and the paired stock
        // restore — atomic with this write — is rolled back with it.
        // Double-restoration is therefore impossible at the backend, not
        // merely guarded against by the client that usually performs it.
        // A stale screen, a double tap, and two managers racing each other
        // all land on the same denial.
        //
        // Read through .get() with a default: orders written before this
        // field was mandatory may not carry a status at all, and dot
        // notation on a missing field errors out as a permission denial
        // that can't be told apart from a real one.
        //
        // MULTI-STORE: placeOrder writes one order per store, stamped with
        // storeId, and only THAT store's manager may work it. An order
        // from before stores existed has no storeId and is frozen until
        // scripts/migrate-to-stores.mjs stamps it — see managesStore().
        //
        allow update: if (
            managesStore(resource.data.get('storeId', null)) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
            request.resource.data.status in
              ['pending', 'processing', 'shipped', 'delivered', 'cancelled'] &&
            (
              request.resource.data.status != 'cancelled' ||
              resource.data.get('status', 'pending') in ['pending', 'processing']
            )
          ) ||
          // Order chat bookkeeping — see chatMetaIsValid(). Each side may
          // stamp only its own read marker and "last message" as itself,
          // and nothing else on the order, so the chat cannot become a
          // back door to the status, the total or the address.
          (isActiveOwner(userId) && chatMetaIsValid('customer', 'customerReadAt')) ||
          (managesStore(resource.data.get('storeId', null)) && chatMetaIsValid('store', 'storeReadAt'));

        // ORDER CHAT. One conversation per order, between the customer who
        // placed it and the Store Manager of the store that sells it — the
        // same two parties who can read the order itself, and nobody else.
        // Not the Platform Admin, and not another store's manager: a chat
        // carries the same private details (names, addresses, photos of
        // what arrived) that the order does.
        //
        // Messages change only the way Messenger lets them, and each way
        // leaves a trace, because a chat about a disputed order is a record
        // of what each side said:
        //   - edit: your own text, within 15 minutes, marked editedAt
        //   - unsend: your own message, which stays as a "was unsent"
        //     placeholder rather than vanishing
        //   - react: one emoji per person per message, from a fixed set
        // No delete, for anyone.
        match /messages/{messageId} {
          function inThisChat() {
            return isActiveOwner(userId) ||
              managesStore(chatOrder(userId, orderId).data.get('storeId', null));
          }
          function isMine() {
            return resource.data.senderId == request.auth.uid &&
              resource.data.get('deleted', false) != true &&
              inThisChat();
          }
          function changed() {
            return request.resource.data.diff(resource.data).affectedKeys();
          }

          allow read: if isOwner(userId) ||
            managesStore(chatOrder(userId, orderId).data.get('storeId', null));

          allow update: if request.auth != null && (
            // Edit. Text only, still something to say, and the clock is
            // the server's, so "within 15 minutes" cannot be faked.
            (
              isMine() &&
              changed().hasOnly(['text', 'editedAt']) &&
              request.resource.data.editedAt == request.time &&
              request.time < resource.data.createdAt + duration.value(15, 'm') &&
              request.resource.data.text is string &&
              request.resource.data.text.size() <= 1000 &&
              (request.resource.data.text.matches('.*\\S.*') || 'imageUrl' in resource.data)
            ) ||
            // Unsend. The words, the photo link, the quote and the
            // reactions go; that a message was here stays.
            (
              isMine() &&
              changed().hasOnly(['deleted', 'deletedAt', 'text', 'imageUrl', 'replyTo', 'reactions', 'editedAt']) &&
              request.resource.data.deleted == true &&
              request.resource.data.deletedAt == request.time &&
              request.resource.data.text == '' &&
              !('imageUrl' in request.resource.data) &&
              !('replyTo' in request.resource.data) &&
              !('reactions' in request.resource.data)
            ) ||
            // React. Your own entry in the reactions map and nobody
            // else's, from the same six the picker offers.
            (
              inThisChat() &&
              resource.data.get('deleted', false) != true &&
              changed().hasOnly(['reactions']) &&
              request.resource.data.reactions is map &&
              request.resource.data.reactions.diff(resource.data.get('reactions', {}))
                .affectedKeys().hasOnly([request.auth.uid]) &&
              (
                !(request.auth.uid in request.resource.data.reactions) ||
                request.resource.data.reactions[request.auth.uid] in
                  ['❤️', '😆', '😮', '😢', '😠', '👍']
              )
            )
          );

          allow create: if request.auth != null &&
            request.resource.data.keys().hasOnly(['senderId', 'sender', 'text', 'imageUrl', 'createdAt', 'replyTo']) &&
            // A reply carries a short quote of what it answers, so the
            // bubble can show it without a read per message.
            (
              !('replyTo' in request.resource.data) ||
              (request.resource.data.replyTo is map &&
               request.resource.data.replyTo.keys().hasOnly(['id', 'text', 'sender', 'hasImage']) &&
               request.resource.data.replyTo.id is string &&
               request.resource.data.replyTo.text is string &&
               request.resource.data.replyTo.text.size() <= 200 &&
               request.resource.data.replyTo.sender in ['customer', 'store'])
            ) &&
            request.resource.data.keys().hasAll(['senderId', 'sender', 'text', 'createdAt']) &&
            request.resource.data.senderId == request.auth.uid &&
            request.resource.data.createdAt == request.time &&
            request.resource.data.text is string &&
            request.resource.data.text.size() <= 1000 &&
            (
              !('imageUrl' in request.resource.data) ||
              (request.resource.data.imageUrl is string &&
               request.resource.data.imageUrl.size() > 0 &&
               request.resource.data.imageUrl.size() <= 2000)
            ) &&
            // Something to say: words, a photo, or both. Whitespace alone
            // is not a message.
            (request.resource.data.text.matches('.*\\S.*') || 'imageUrl' in request.resource.data) &&
            exists(/databases/$(database)/documents/users/$(userId)/orders/$(orderId)) &&
            (
              (request.resource.data.sender == 'customer' && isActiveOwner(userId)) ||
              (request.resource.data.sender == 'store' &&
                managesStore(chatOrder(userId, orderId).data.get('storeId', null)))
            );
        }
      }
      match /cart/{itemId} {
        allow read, write: if isActiveOwner(userId);
      }
      match /favorites/{productId} {
        // New: favorites just migrated off AsyncStorage onto Firestore,
        // same per-user subcollection shape as cart. Same isActiveOwner()
        // gate — a deactivated account shouldn't be able to favorite
        // new items either.
        allow read, write: if isActiveOwner(userId);
      }
    }
    // Same store-only read as above, for AdminOrdersScreen and the
    // dashboard, which read every customer's orders as one collection
    // group — filtered to where('storeId', '==', their store).
    match /{path=**}/orders/{orderId} {
      allow read: if managesStore(resource.data.get('storeId', null));
    }
    // Field validation for products, delivering the "strict data type
    // enforcement on the backend" the SRS promises (Security, p.29).
    //
    // Takes the document as a parameter so the same checks cover both
    // create (where the parameter is the new document) and update (where
    // it's the MERGED result — Firestore hands rules the whole document
    // after the write, not just the changed keys).
    //
    // Every field is read through .get() with a default that passes, so a
    // field that simply isn't there can't fail the check. That matters on
    // update: products created by earlier versions of this app may carry
    // fields this rule never mentions, and a strict key allowlist would
    // make those products uneditable. Create is where the allowlist
    // belongs — see isNewProductShape() — because a new document is
    // entirely under the app's control.
    //
    // On XSS specifically: type and length enforcement is what rules can
    // do, and it's what's implemented here. It bounds what can be stored,
    // but it doesn't sanitise markup — React Native's <Text> renders
    // strings as text and never interprets HTML, so stored markup has no
    // execution path in this app to begin with.
    function productFieldsAreWellTyped(data) {
      return data.get('name', 'x') is string &&
        data.get('name', 'x').size() <= 120 &&
        data.get('price', 0) is number &&
        data.get('price', 0) >= 0 &&
        data.get('stock', 0) is number &&
        data.get('stock', 0) >= 0 &&
        data.get('type', '') is string &&
        data.get('type', '').size() <= 60 &&
        data.get('description', '') is string &&
        data.get('description', '').size() <= 2000 &&
        data.get('imageUrl', '') is string &&
        data.get('imageUrl', '').size() <= 2000 &&
        data.get('colors', []) is list &&
        data.get('sizes', []) is list;
    }
    // Create-only: the exact key set AdminAddProductScreen writes, with a
    // non-empty name and a server-set createdAt. measurements and
    // measurementType are optional — they're omitted entirely rather than
    // written as null when the seller left the size guide blank.
    //
    // storeId is required: a product with no store has no manager, so no
    // one could ever edit, restock or remove it (see managesStore).
    function isNewProductShape() {
      return request.resource.data.keys().hasOnly(
          ['name', 'price', 'type', 'stock', 'description', 'imageUrl',
           'colors', 'sizes', 'createdAt', 'measurements', 'measurementType',
           'storeId']
        ) &&
        request.resource.data.keys().hasAll(
          ['name', 'price', 'type', 'stock', 'description', 'imageUrl',
           'colors', 'sizes', 'createdAt', 'storeId']
        ) &&
        request.resource.data.name.matches('.*\\S.*') &&
        request.resource.data.createdAt == request.time;
    }
    match /products/{productId} {
      allow read: if request.auth != null;
      // OWNERSHIP, for all three writes: a Store Manager may only create,
      // edit or delete products of the store they are assigned to. Create
      // checks the incoming storeId, so a manager cannot list an item under
      // someone else's store; update and delete check the STORED one, so a
      // manager cannot reach into another store's catalogue.
      //
      // A product written before stores existed carries no storeId and is
      // therefore frozen for everyone until scripts/migrate-to-stores.mjs
      // assigns it. That is the fail-closed direction: guessing an owner
      // for it here would be guessing which store gets someone's stock.
      allow create: if managesStore(request.resource.data.storeId) &&
        isNewProductShape() &&
        productFieldsAreWellTyped(request.resource.data);
      allow delete: if managesStore(resource.data.get('storeId', null));
      // ONLY a seller may update a product. There is no customer branch:
      // checkout's stock decrement moved into the placeOrder Cloud
      // Function (functions/index.js), which runs as Admin and bypasses
      // this file, so no signed-in customer needs write access here any
      // more.
      //
      // WHAT THE REMOVED BRANCH ALLOWED, recorded because it looked safe:
      // it let any active signed-in user decrement "stock" on any product,
      // requiring only that stock be the sole changed key and the new
      // value be a smaller non-negative number. It could not rewrite
      // price or name, so it read as tightly scoped — but it was never
      // tied to an order. Anyone with an account could walk the catalogue
      // and decrement every product to zero, one write at a time, with no
      // purchase and nothing to refund; the store simply goes out of
      // stock. Nothing in rules could have fixed that, because the
      // constraint that makes a decrement legitimate ("it matches the
      // quantities on an order I just paid for") requires reading a
      // sibling write, which rules cannot do. That is precisely why the
      // operation belongs on a server, and why this branch is deleted
      // rather than narrowed.
      //
      // A SECOND THING THE REMOVAL FIXES, silently: the old branch
      // required `resource.data.stock is number`, so a product created by
      // an older build with stock stored as a string could not be
      // decremented at all — checkout failed on it exactly as if it were
      // out of stock, until a seller re-saved the product once. The
      // function has no such limit: it coerces on read and writes a
      // number back, so a legacy product migrates itself on its first
      // sale. See utils/stock.js parseStockLimit.
      //
      // Seller updates still validate the RESULT, not the delta:
      // AdminEditProductScreen sends every field on save (migrating
      // legacy string price/stock to numbers as it goes), so a legacy
      // product becomes compliant the first time it is saved rather than
      // being locked out.
      //
      // ON THE CANCELLATION STOCK RESTORE: cancelling an order writes an
      // INCREMENTED stock here, in the same transaction as the order's
      // status change. No new branch was added for it and nothing was
      // loosened — the existing seller branch already permits it, because
      // adjusting stock is the Store Manager's ordinary job (that is what
      // AdminEditProductScreen does), and the result still has to be a
      // well-typed, non-negative number. Cancellation is a seller action
      // performed from AdminOrdersScreen, so it needs no customer access
      // and is unaffected by the branch removal above.
      //
      // HONEST LIMITATION, and the reason no narrower rule is attempted:
      // rules cannot tie this write to the order write it travels with.
      // Each write in a transaction is evaluated on its own, against its
      // own document — a rule on products/{productId} has no view of the
      // sibling order write and no way to learn which order it belongs to,
      // so "this must equal the quantity on the order being cancelled" is
      // not expressible here. It is enforced instead by the two properties
      // that ARE enforceable: the transaction computes the amount from the
      // order's own line items (never from client input), and the order
      // rule above admits at most one pending/processing -> cancelled
      // transition per order. A repeat or out-of-state cancellation is
      // denied on the ORDER document, and because the two writes are
      // atomic, the stock increment dies with it.
      //
      // What remains outside that fence is a Store Manager editing stock
      // directly through Edit Product, which is a granted power of the
      // role rather than a hole in this path, and which the activity log
      // records. Closing it would take a server-side trigger. The project
      // now has a functions/ codebase, so that is no longer impossible —
      // only unbuilt, and deliberately so: a manager adjusting stock is a
      // legitimate action, not an attack to be blocked. Same boundary the
      // activityLogs comment draws.
      //
      // storeId must survive the update unchanged. Checking the stored
      // value stops a manager reaching into another store's product; this
      // second line stops them pushing their own product into another
      // store's catalogue, which that check alone would allow.
      allow update: if managesStore(resource.data.get('storeId', null)) &&
        request.resource.data.get('storeId', null) == resource.data.get('storeId', null) &&
        productFieldsAreWellTyped(request.resource.data);
    }
    // The stores a Store Manager can be assigned to.
    //
    // Created by a Platform Admin, because deciding who sells on the
    // platform is account administration — the same reason a Platform
    // Admin, not the applicant, grants the Store Manager role. There is no
    // vendor self-signup, deliberately: see ROLES.md.
    //
    // Readable by any signed-in user, like /products: a shopper will be
    // browsing by store, and a store's name is not private.
    //
    // No delete rule, for anyone. Products and orders point at a store by
    // id, and deleting the store would leave them pointing at nothing —
    // the same reasoning as accounts being deactivated, not deleted.
    match /stores/{storeId} {
      allow read: if request.auth != null;
      allow create: if isPlatformAdmin() &&
        request.resource.data.keys().hasOnly(['name', 'createdAt']) &&
        request.resource.data.keys().hasAll(['name', 'createdAt']) &&
        request.resource.data.name is string &&
        request.resource.data.name.matches('.*\\S.*') &&
        request.resource.data.name.size() <= 60 &&
        request.resource.data.createdAt == request.time;
      allow update: if (
          isPlatformAdmin() &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']) &&
          request.resource.data.name is string &&
          request.resource.data.name.matches('.*\\S.*') &&
          request.resource.data.name.size() <= 60
        ) ||
        // STORE PROFILE: the store's own manager may set its logo and a
        // short description — what shoppers see on the store page. Not
        // the name: renaming a store changes what every past order and
        // review says it was, so that stays with the Platform Admin.
        // Either field may be removed (absent afterwards).
        (
          managesStore(storeId) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['logoUrl', 'description']) &&
          (
            !('logoUrl' in request.resource.data) ||
            (request.resource.data.logoUrl is string &&
             request.resource.data.logoUrl.size() > 0 &&
             request.resource.data.logoUrl.size() <= 2000)
          ) &&
          (
            !('description' in request.resource.data) ||
            (request.resource.data.description is string &&
             request.resource.data.description.size() <= 300)
          )
        );
    }
    // Product reviews, restricted to verified purchases.
    //
    // WHY THIS COLLECTION EXISTS AT ALL, since "reviews" in a marketplace
    // usually means something else: when this was written PlainCo was a
    // SINGLE store — the 'seller' role was that store's own manager, and
    // products carried no store at all. With one store there was no seller
    // to rate (one seller, one number, nothing to compare it against).
    // Now that orders are split per store, each review carries the storeId
    // of the order it came from (checked below), and a store's seller
    // rating is simply its reviews summarised on the client — no separate
    // write, so nothing here to validate beyond the review itself. There
    // is still no customer to rate (a store accepts every order, so a
    // buyer score would feed no decision, and it would publish reputation
    // data about consumers). The trust problem PlainCo actually has is the one stated
    // in PRODUCT.md: shoppers must believe the condition of secondhand
    // clothing they are buying sight-unseen. That is a claim about an
    // ITEM, and this is where it is recorded.
    //
    // THE VERIFIED-PURCHASE CHAIN, which is the entire claim this feature
    // makes, and the reason it lives in rules rather than in the client:
    //
    //   1. Clients cannot create orders at all (above). Only the
    //      placeOrder Cloud Function writes them, and it sets
    //      status: 'pending' as a literal — it accepts no status from the
    //      caller. This link used to be a create rule here that pinned
    //      the field; it is now enforced in functions/index.js instead.
    //   2. Only isSeller() may move an order to 'delivered' (above).
    //   3. create below demands the caller's OWN order, in status
    //      'delivered', containing the product being reviewed.
    //
    // "Verified purchase" is therefore a property of the stored data
    // rather than a label the UI prints beside a review. Break any one
    // link and the badge becomes decoration — so note that link 1 no
    // longer lives in this file. A change to how placeOrder sets status
    // is a change to what the review badge means, and the two must be
    // reviewed together even though they sit in different files.
    //
    // ONE REVIEW PER ORDER LINE is structural, not a client convention:
    // the document id is derived — orderId + '_' + productId — and the
    // rule below requires it to match the fields inside. A second review
    // of the same line is therefore a create against a document that
    // already exists, which Firestore refuses on its own; and a create
    // under any other id fails the id check. Buying the same item again on
    // a later order does earn a second review, which is correct — that is
    // a second purchase, and the id differs by orderId.
    //
    // Reads three documents, plus the two isActiveUser() spends: five,
    // inside the ten-access ceiling a single-document request allows.
    //
    // storeId must be the ORDER's store, so the review lands in the
    // moderation queue of the store that sold the item — and cannot be
    // pointed at a store of the reviewer's choosing. Same order document,
    // so no extra access.
    function isDeliveredPurchase(orderId, productId, storeId) {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)/orders/$(orderId)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/orders/$(orderId))
          .data.get('status', '') == 'delivered' &&
        productId in
          get(/databases/$(database)/documents/users/$(request.auth.uid)/orders/$(orderId))
            .data.get('productIds', []) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)/orders/$(orderId))
          .data.get('storeId', null) == storeId;
    }
    match /reviews/{reviewId} {
      // Any signed-in user, matching /products — a review the next shopper
      // cannot read does not do the one job it has.
      //
      // HONEST LIMITATION on hidden reviews: rules cannot inspect a
      // query's filters, only allow or deny the read as a whole, so a
      // moderated review is still fetchable by a client that queries this
      // collection directly. The app filters hidden === true out of every
      // list it renders. What the rules DO guarantee is that hiding is the
      // only moderation available (there is no delete, for anyone), that
      // the text survives exactly as its author wrote it, and that the
      // Store Manager who hid it is named in activityLogs. Enforcing the
      // filter itself would take a server-side read path — buildable now
      // that functions/ exists, but not built. The same boundary the
      // activityLogs comment draws.
      allow read: if request.auth != null;

      // hidden must be written false at creation, for the same reason a
      // supportRequest must be created 'open': a review that could arrive
      // pre-hidden is a review that never has to pass through moderation
      // to disappear, which turns the flag into a way to stage content
      // outside the queue rather than a record of a decision.
      //
      // userName is a display-name snapshot, deliberately copied rather
      // than joined at read time: /users is readable only by its owner and
      // a platformAdmin (see above), so a shopper reading someone else's
      // review could never resolve the author's name from the user doc.
      // productName is copied for the same reason the Store Manager's
      // moderation queue needs it — to name the item without a second read
      // per row.
      allow create: if isActiveUser() &&
        request.resource.data.keys().hasOnly(
          ['orderId', 'productId', 'productName', 'userId', 'userName',
           'rating', 'matchedDescription', 'text', 'hidden', 'createdAt',
           'storeId', 'userPhotoUrl']
        ) &&
        // The author's profile photo, copied at write time like userName,
        // because /users is unreadable to other shoppers.
        request.resource.data.get('userPhotoUrl', '') is string &&
        request.resource.data.get('userPhotoUrl', '').size() <= 2000 &&
        request.resource.data.keys().hasAll(
          ['orderId', 'productId', 'userId', 'rating', 'matchedDescription',
           'hidden', 'createdAt', 'storeId']
        ) &&
        request.resource.data.storeId is string &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.orderId is string &&
        request.resource.data.productId is string &&
        reviewId == request.resource.data.orderId + '_' + request.resource.data.productId &&
        request.resource.data.rating is int &&
        request.resource.data.rating >= 1 &&
        request.resource.data.rating <= 5 &&
        request.resource.data.matchedDescription is bool &&
        request.resource.data.get('text', '') is string &&
        request.resource.data.get('text', '').size() <= 1000 &&
        request.resource.data.get('productName', '') is string &&
        request.resource.data.get('productName', '').size() <= 120 &&
        request.resource.data.get('userName', '') is string &&
        request.resource.data.get('userName', '').size() <= 60 &&
        request.resource.data.hidden == false &&
        request.resource.data.createdAt == request.time &&
        isDeliveredPurchase(
          request.resource.data.orderId,
          request.resource.data.productId,
          request.resource.data.storeId
        );

      // Two disjoint branches, neither able to reach the other's fields.
      //
      // Author branch: the person who wrote it may revise what they said.
      // orderId, productId and userId are absent from the allowlist, so a
      // revision cannot re-point a review at a different product or a
      // different author — which matters, because those three fields are
      // exactly what create verified against a real delivered order.
      // Without that exclusion a review earned on one purchase could be
      // walked onto any other product afterwards, and the chain above
      // would be worth nothing.
      //
      // Seller branch: 'hidden', and nothing else. A Store Manager cannot
      // rewrite a customer's rating or text, the same way they cannot
      // rewrite a support request's message or an order's line items.
      // Moderation here means suppressing abuse, not editing opinion.
      allow update: if
        (
          isActiveUser() &&
          resource.data.userId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['rating', 'matchedDescription', 'text', 'updatedAt']) &&
          request.resource.data.rating is int &&
          request.resource.data.rating >= 1 &&
          request.resource.data.rating <= 5 &&
          request.resource.data.matchedDescription is bool &&
          request.resource.data.get('text', '') is string &&
          request.resource.data.get('text', '').size() <= 1000 &&
          request.resource.data.updatedAt == request.time
        )
        ||
        (
          // The store that sold the item moderates its reviews, and no
          // other store can hide them — a competitor suppressing reviews
          // is exactly the abuse moderation must not enable.
          managesStore(resource.data.get('storeId', null)) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hidden']) &&
          request.resource.data.hidden is bool
        );

      // No delete rule, for any role — deliberately, and for the same
      // reason accounts are deactivated rather than deleted (SRS §2.4). A
      // store that can erase a review can erase the ones it dislikes, and
      // no reader can tell a clean record apart from a cleaned one. Hiding
      // leaves the document, its author, and its text intact.
    }
    // Who answers a support request, or reads the mail it produced.
    //
    // A request about an ORDER goes to the store that sold it; a general
    // question goes to the Platform Admin, because no single store can
    // answer for the app. storeId is null for the second kind — present
    // and null, not absent, so the Platform Admin's inbox can query
    // where('storeId', '==', null), which does not match a missing field.
    //
    // This does widen the Platform Admin role, which was accounts-only:
    // it now answers general questions too, and still cannot reach any
    // store's requests, orders or products. See ROLES.md.
    function handlesSupport(storeId) {
      return (storeId == null && isPlatformAdmin()) ||
        (storeId != null && managesStore(storeId));
    }
    match /supportRequests/{requestId} {
      // Same treatment as products: an exact key allowlist plus types and
      // length caps, matching what HelpScreen.js submits.
      //
      // status must be 'open' at creation — a customer cannot file a
      // request that arrives pre-resolved and therefore never surfaces in
      // the Store Manager's open queue.
      //
      // userEmail is allowed to be null, not just a string: HelpScreen
      // writes auth.currentUser?.email, and a provider that supplied no
      // email would store null there rather than omit the field.
      //
      // Routing is checked, not trusted. A request that names an order must
      // name the caller's OWN order and that order's store — otherwise a
      // customer could drop a message into any store's queue, or attach a
      // stranger's order to it. A general request names neither.
      allow create: if request.auth != null &&
        request.resource.data.keys().hasOnly(
          ['message', 'userId', 'userEmail', 'status', 'createdAt', 'orderId', 'storeId']
        ) &&
        request.resource.data.keys().hasAll(
          ['message', 'userId', 'status', 'createdAt', 'storeId']
        ) &&
        (
          (
            request.resource.data.storeId == null &&
            !('orderId' in request.resource.data)
          ) || (
            request.resource.data.orderId is string &&
            request.resource.data.storeId is string &&
            exists(/databases/$(database)/documents/users/$(request.auth.uid)/orders/$(request.resource.data.orderId)) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)/orders/$(request.resource.data.orderId))
              .data.get('storeId', null) == request.resource.data.storeId
          )
        ) &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.message is string &&
        request.resource.data.message.matches('.*\\S.*') &&
        request.resource.data.message.size() <= 2000 &&
        (request.resource.data.get('userEmail', '') is string ||
         request.resource.data.userEmail == null) &&
        request.resource.data.status == 'open' &&
        request.resource.data.createdAt == request.time;
      allow read: if handlesSupport(resource.data.get('storeId', null));
      // Working a request means moving it between exactly two states, and
      // that is the only change this rule permits — whoever handles it
      // cannot edit the customer's message, reassign the request to
      // another user, or move it to another store's queue.
      allow update: if handlesSupport(resource.data.get('storeId', null)) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']) &&
        request.resource.data.status in ['open', 'resolved'];
      allow delete: if handlesSupport(resource.data.get('storeId', null));
    }
    // Activity logging (SRS Constraint 2.4.5, "Audit Functions").
    //
    // TWO collections rather than one with a "domain" field, because
    // Firestore rules cannot inspect a query's filters: a rule can only
    // allow or deny a read of the collection as a whole. A single log
    // would therefore have to be readable by both roles — meaning a Store
    // Manager could read account-management history, or a Platform Admin
    // could read store operations. Splitting the collection is what keeps
    // the log's read boundary the same shape as the role boundary
    // everywhere else.
    //
    // Both are APPEND-ONLY: create is the only write verb allowed, for
    // every role, so a record can't be rewritten or erased after the fact
    // by the same account that produced it. That is the property that
    // makes a log worth keeping.
    //
    // HONEST LIMITATION: these entries are written by the client, right
    // after the action they describe. Rules can enforce that an entry is
    // well-formed, truthfully attributed, and never altered — but they
    // cannot force a modified client to write one at all. This is an
    // operational activity log for monitoring, per the SRS, not a
    // tamper-proof security audit trail; guaranteeing that would take a
    // server-side trigger. functions/ exists now (see placeOrder), so the
    // door is open, but no such trigger has been written. See ROLES.md.
    //
    // extraKeys: fields one log requires beyond the shared seven — storeId
    // for the store log, nothing for the account log.
    function isValidLogEntry(extraKeys) {
      return request.resource.data.keys().hasOnly(
          ['action', 'actorId', 'actorEmail', 'targetId', 'targetLabel', 'summary', 'createdAt']
            .concat(extraKeys)
        ) &&
        request.resource.data.keys().hasAll(
          ['action', 'actorId', 'actorEmail', 'targetId', 'targetLabel', 'summary', 'createdAt']
            .concat(extraKeys)
        ) &&
        // An entry cannot be attributed to anyone but its author, so a
        // privileged account can't log its own actions under someone
        // else's name.
        request.resource.data.actorId == request.auth.uid &&
        request.resource.data.action is string &&
        request.resource.data.action.size() <= 40 &&
        request.resource.data.actorEmail is string &&
        request.resource.data.targetId is string &&
        request.resource.data.targetLabel is string &&
        request.resource.data.targetLabel.size() <= 120 &&
        request.resource.data.summary is string &&
        request.resource.data.summary.size() <= 200 &&
        // Forces serverTimestamp() — request.time is the server's clock,
        // so a client cannot backdate or post-date an entry to disguise
        // when something happened.
        request.resource.data.createdAt == request.time;
    }
    // Store operations: product changes and order transactions. The Store
    // Manager's domain, and the pair the SRS names explicitly.
    // read and create are stated separately on purpose: isValidLogEntry()
    // reads request.resource, which only exists on a write, so folding
    // them into one `allow read, create` would make every read fail.
    //
    // MULTI-STORE: each entry names the store it happened in, a manager may
    // only write entries for their own store, and reads only those. One
    // store's product edits and cancellations are not another store's
    // business. Entries from before stores existed carry no storeId and
    // are unreadable until the migration stamps them.
    match /activityLogs/{logId} {
      allow read: if managesStore(resource.data.get('storeId', null));
      allow create: if managesStore(request.resource.data.get('storeId', null)) &&
        isValidLogEntry(['storeId']);
    }
    // Account management: role grants and activation changes. The Platform
    // Admin's domain.
    match /accountLogs/{logId} {
      allow read: if isPlatformAdmin();
      allow create: if isPlatformAdmin() && isValidLogEntry([]);
    }
    // Delivery record for transactional email, written by functions/mailer.js
    // with Admin credentials. READ ONLY, and read by one role.
    //
    // WHY IT NEEDS A RULE AT ALL when it had none: it was unreachable from
    // every client, which was correct while nothing read it — and useless,
    // because a receipt that failed to send was recorded where no human
    // would ever look. AdminMailLogScreen is that reader.
    //
    // NO WRITE RULE, for anyone, ever. This is a record of what the server
    // did; a client able to edit it could mark a failed send as delivered,
    // which turns the log from evidence into decoration. The mailer
    // bypasses rules entirely, so it needs no grant here.
    //
    // isSeller() rather than isPlatformAdmin(), following the same split
    // the two activity logs draw: these entries are about orders and
    // support requests, which is store operations — the Store Manager's
    // domain. A platformAdmin cannot read orders (see the collection-group
    // rule above) and has no business reading who was emailed about one.
    //
    // ON THE ADDRESSES INSIDE: entries carry a recipient email. That is not
    // new exposure — a seller already reads customerEmail on every order
    // and userEmail on every support request, which are the same two
    // sources these are copied from.
    //
    // MULTI-STORE: each entry carries the storeId of the order or support
    // request it was about, and is read by whoever handles that — a store's
    // receipts by its manager, a general question's notification by the
    // Platform Admin (see handlesSupport). One store has no business
    // reading who another store emailed.
    match /mailLog/{entryId} {
      allow read: if handlesSupport(resource.data.get('storeId', null));
    }

    // ONLINE CHECKOUTS awaiting PayMongo — see placeOrder and applyPayment
    // in functions/index.js. The customer reads their own, which is how
    // the app's "finish paying" screen learns the webhook arrived. Nobody
    // writes: a client that could set status to 'paid' would have bought
    // the order, and a client that could set it to 'released' would get
    // held stock back without the gateway being told to stop.
    //
    // Read as a single document only. The app never lists checkouts, and
    // a list query would have to filter on customerId to pass anyway.
    match /checkouts/{checkoutId} {
      allow get: if request.auth != null &&
        resource.data.customerId == request.auth.uid;
    }

    // Settings the app and the functions both read. payments.gateway says
    // whether online methods open the sandbox or PayMongo. Written from
    // the console only — a customer who could flip it back to 'sandbox'
    // could pay with a pretend bank.
    match /config/{docId} {
      allow get: if request.auth != null;
    }
  }
}
